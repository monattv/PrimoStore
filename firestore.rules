rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shoes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /clients/{id} {
      allow create, update: if true;
      allow read: if request.auth != null;
    }
  }
}

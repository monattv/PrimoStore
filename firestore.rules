rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shoes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ads/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /info/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sales/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // coupon: i clienti possono controllare un codice che conoscono, ma solo il gestore può vedere l'elenco
    match /coupons/{id} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }
    match /reviews/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /notifs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // clienti: chi si registra/accede può cercare il proprio numero; solo il gestore vede l'elenco completo
    match /clients/{id} {
      allow create, update: if true;
      allow get: if true;
      allow list: if request.auth != null;
    }
  }
}

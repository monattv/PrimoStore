rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shoes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ads/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /info/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sales/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // coupon: i clienti possono controllare un codice che conoscono, ma solo il gestore può vedere l'elenco
    match /coupons/{id} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }
    match /clients/{id} {
      allow create, update: if true;
      allow read: if request.auth != null;
    }
  }
}
